CC = gcc
# QUAN TRỌNG: KHÔNG dùng -fsanitize=address,undefined ở đây
CFLAGS = -Wall -g -O0 -I. 

OBJS = test_memphy.o mm-memphy.o

test_memphy: $(OBJS)
	$(CC) $(CFLAGS) -o test_memphy $(OBJS)

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

# Target chạy bình thường
run: test_memphy
	./test_memphy

# Target chạy với Valgrind
valgrind: test_memphy
	valgrind --leak-check=full \
	         --show-leak-kinds=all \
	         --track-origins=yes \
	         ./test_memphy

clean:
	rm -f *.o test_memphy